rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Connection health verification
    match /_connection_test/{docId} {
      allow read: if true;
    }

    // 2. User profile and all personal school data synced across devices
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Global Default Deny for unauthenticated or non-owner access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
