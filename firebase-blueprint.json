{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with Firebase Auth Google identity details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "organizationName": { "type": "string" },
        "phone": { "type": "string" },
        "schoolId": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserDatabase": {
      "title": "UserDatabase",
      "description": "User multi-device synchronized school database snapshot",
      "type": "object",
      "properties": {
        "schools": { "type": "array" },
        "students": { "type": "array" },
        "staff": { "type": "array" },
        "studentAttendance": { "type": "array" },
        "staffAttendance": { "type": "array" },
        "examinations": { "type": "array" },
        "examMarks": { "type": "array" },
        "payroll": { "type": "array" },
        "visits": { "type": "array" },
        "issues": { "type": "array" },
        "tasks": { "type": "array" },
        "documents": { "type": "array" },
        "notifications": { "type": "array" },
        "settings": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time push notification alert for school state changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "priority": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "targetRole": { "type": "string" },
        "actorRole": { "type": "string" },
        "actorName": { "type": "string" },
        "actorUid": { "type": "string" },
        "actionTab": { "type": "string" },
        "date": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "type", "title", "message", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user profile documents"
    },
    "/users/{userId}/data/{dataId}": {
      "schema": { "$ref": "#/entities/UserDatabase" },
      "description": "User's synchronized schools, students, teachers, and attendance records"
    },
    "/schools/{schoolId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time synchronized push alerts between Head Teachers and Operators"
    }
  }
}
