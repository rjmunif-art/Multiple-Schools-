rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Connection test
    match /_connection_test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSchoolOwner(schoolId) {
      return isSignedIn() && exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid;
    }

    function isSchoolHeadTeacher(schoolId) {
      let schoolData = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return isSignedIn() && (
        schoolData.headTeacherUid == request.auth.uid ||
        (request.auth.token.email != null && schoolData.headTeacherEmail == request.auth.token.email.lower())
      );
    }

    // 2. User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.role in ['headTeacher', 'head_teacher']
      );
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.role in ['headTeacher', 'head_teacher']
      );
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 3. Invites
    // - a signed-in user can read invites/{their own lowercase email}
    // - the owner operator can create, read, update and delete invites for their own schools
    match /invites/{inviteEmail} {
      allow get: if isSignedIn() && (
        (request.auth.token.email != null && inviteEmail == request.auth.token.email.lower()) ||
        resource.data.operatorUid == request.auth.uid ||
        isSchoolOwner(resource.data.schoolId)
      );
      allow list: if isSignedIn() && (
        resource.data.operatorUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.operatorUid == request.auth.uid &&
        (isSchoolOwner(request.resource.data.schoolId) || !exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)))
      );
      allow update, delete: if isSignedIn() && (
        resource.data.operatorUid == request.auth.uid ||
        isSchoolOwner(resource.data.schoolId) ||
        (request.auth.token.email != null && inviteEmail == request.auth.token.email.lower())
      );
    }

    // 4. Schools
    // - a head teacher can read and write only their assigned school's data
    match /schools/{schoolId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.headTeacherUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.headTeacherEmail == request.auth.token.email.lower())
      );
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.headTeacherUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.headTeacherEmail == request.auth.token.email.lower())
      );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Isolated Assistant Chats: Only the creator of the chat can read/write
      match /assistantChats/{chatId} {
        allow read, write: if isSignedIn() && (
          (resource == null && request.resource.data.userId == request.auth.uid) ||
          (resource != null && resource.data.userId == request.auth.uid)
        );

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && (
            get(/databases/$(database)/documents/schools/$(schoolId)/assistantChats/$(chatId)).data.userId == request.auth.uid
          );
        }

        match /{allSubcollections=**} {
          allow read, write: if isSignedIn() && (
            get(/databases/$(database)/documents/schools/$(schoolId)/assistantChats/$(chatId)).data.userId == request.auth.uid
          );
        }
      }

      // School data subcollections (students, staff, attendance, payroll, etc.)
      // a head teacher can read and write only their assigned school's data
      match /{subcollection}/{docId} {
        allow read, write: if subcollection != 'assistantChats' && (
          isSchoolOwner(schoolId) || isSchoolHeadTeacher(schoolId)
        );
      }

      match /{subcollection}/{docId}/{nested=**} {
        allow read, write: if subcollection != 'assistantChats' && (
          isSchoolOwner(schoolId) || isSchoolHeadTeacher(schoolId)
        );
      }
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
